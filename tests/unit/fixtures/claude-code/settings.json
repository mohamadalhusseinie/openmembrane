{
  "permissions": {
    "allow": ["Bash(npm test)"]
  },
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "logout",
        "hooks": [{ "type": "command", "command": "echo user-hook" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "echo user-stop" }]
      }
    ]
  }
}
